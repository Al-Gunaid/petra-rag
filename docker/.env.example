# ============================================================================
# PETRA-RAG — .env
# ----------------------------------------------------------------------------
# Zentrale Konfiguration für docker-compose.yml.
# Stand: Phase 3 (Workflow v3.0, Hybrid-Retrieval mit RRF-Fusion)
#
# Diese Datei wird von Compose automatisch gelesen, wenn sie als ".env" im
# selben Verzeichnis wie docker-compose.yml liegt.
#
# WICHTIG: Damit die Werte auch in den n8n-Function-Nodes ankommen, muss
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false gesetzt sein (in docker-compose.yml).
# Ohne diese Variable liefern alle $env-Ausdrücke "undefined" und der
# Workflow arbeitet still mit seinen eigenen Defaults weiter.
#
# Vorlage: nach docker/.env kopieren und N8N_PASSWORD setzen. Die echte .env nie committen.
# ============================================================================
 
# ── n8n Authentifizierung (PFLICHT) ──────────────────────────
N8N_USER=admin
N8N_PASSWORD=BITTE_SETZEN

# ── Dienst-Endpunkte ────────────────────────────────────────────────────────
# Docker-Servicenamen, KEIN localhost — im Container-Netz löst 127.0.0.1
# auf den Container selbst auf, nicht auf den Nachbardienst.

PETRA_N8N_QUERY_WEBHOOK_URL=http://n8n:5678/webhook/petra-query
PETRA_CHROMA_URL=http://chromadb:8000
PETRA_N8N_TIMEOUT=150
# Ollama im Docker-Netzwerk
PETRA_OLLAMA_URL=http://ollama:11434
# Muss auf den Service zeigen, der /retrieval/bm25 bereitstellt.
# ACHTUNG Port 8001 — auf 8000 liegt ChromaDB, nicht die API.
PETRA_API_BASE=http://ingestion-api:8001

# ── Embedding-Modell (FA-ING-08) ─────────────────────────────
# Primär: BAAI/bge-m3 (Spez Abschn 2.3.2)
# Fallback: paraphrase-multilingual-MiniLM-L12-v2
MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=8

 
# Modellnamen auf Ollama-Seite. Müssen mit den Node-Parametern im
# n8n-Workflow übereinstimmen — bei Änderung an BEIDEN Stellen pflegen.

PETRA_LLM_MODEL=llama3.1:8b
PETRA_EMBEDDING_MODEL=bge-m3:latest

# ── ChromaDB Score-Semantik ─────────────────────────────────────────
# cosine_similarity | cosine_distance | l2 | auto
# Bei "auto" greift eine Heuristik. Explizit setzen ist besser: Ein
# falsch interpretierter Score-Raum invertiert die Vergleichsrichtung
# des CRAG-Filters, der dann systematisch die SCHLECHTESTEN Chunks
# passieren lässt — im Betrieb nicht sichtbar.
PETRA_CHROMA_SCORE_SPACE=cosine_distance

# ── Upsert-Verhalten (FA-ING-11) ─────────────────────────────
# always = immer überschreiben | skip = Duplikate überspringen
UPSERT_MODE=always

# ── OCR-Einstellungen (FA-ING-05) ────────────────────────────
OCR_LANG=deu+eng
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=0.75

# ── Scan-Erkennung (FA-ING-05) ───────────────────────────────
# Seiten mit Textdichte < diesem Wert gelten als Scan
SCAN_DENSITY_THRESHOLD=0.05

# ── Retrieval / Fusion / CRAG ───────────────────────────────────────
PETRA_BM25_INDEX_PATH=/data/bm25_index.jsonl
PETRA_RRF_K=60
PETRA_RRF_TOP_K=15
PETRA_CRAG_MAX_ROUNDS=2

# Schwellwerte: 0,65 (CRAG) und 0,75 (Faithfulness) sind gesetzte Werte
# OHNE empirische Basis. Kap. 4.6.2 fordert dafür ausdrücklich eine
# Calibration-Evaluation über 50 QA-Paare.
# TODO Abgabe: Als bekannte Einschränkung dokumentieren oder kalibrieren.
PETRA_CRAG_THRESHOLD=0.65
PETRA_FAITHFULNESS_THRESHOLD=0.75

# ── Cross-Encoder Reranking (Schicht 3c) ────────────────────────────
# Deaktivieren, wenn das VRAM-Budget knapp ist. Die Pipeline läuft
# dann mit der RRF-Reihenfolge weiter (degradiert, nicht fehlerhaft).
PETRA_RERANKER_ENABLED=true
PETRA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3


# ── CAG-Cache (Schicht 1c) ──────────────────────────────────────────
PETRA_CACHE_ENABLED=true
PETRA_CACHE_PATH=/data/cag_cache.json
PETRA_CACHE_TTL_SECONDS=86400
PETRA_CACHE_MAX_ENTRIES=500

# ── HyDE Query-Expansion (Schicht 1a) ───────────────────────────────
# Default aus: HyDE kostet einen zusätzlichen LLM-Aufruf (~1–2 s) und
# gehört laut Kap. 4.7.2 in Ausbaustufe 3. Erst nach der RAGAs-Baseline
# aktivieren, sonst ist der Effekt nicht messbar.
PETRA_HYDE_ENABLED=true

# ── Agentic Extension (Schicht 6) ───────────────────────────────────
# Default aus (Offline-First, NF-01/NF-02). Bei false liefert der
# Q4-Pfad eine kontrollierte Meldung statt eines potenziell veralteten
# lokalen Preises.
PETRA_WEB_AGENT_ENABLED=true

# ── Telemetrie (Schicht 5c) ─────────────────────────────────────────
# Auswertung nach 30–50 realen Anfragen:
#   python3 evaluation/analyze_telemetry.py --path /data/telemetry.jsonl
#
# Zwei Werte sind dabei entscheidend:
#   ID-Konsistenz     — bei 0 kombiniert RRF keine Ränge (Schritt 4 unvollständig)
#   NF-03-Erfüllung   — unter 0,9 im Kaltpfad erwartet und dokumentiert (A-18)
PETRA_TELEMETRY_ENABLED=true
PETRA_TELEMETRY_PATH=/data/telemetry.jsonl
PETRA_TELEMETRY_REDACT_QUERY=false

# ── RAGAs-Evaluation ────────────────────────────────────────────────
PETRA_RAGAS_JUDGE_MODEL=qwen2.5:14b
PETRA_RAGAS_OUTPUT_DIR=./evaluation/results
RAGAS_JUDGE_PROVIDER=ollama          # oder: openai


# ── Pfade (optional — Defaults funktionieren ohne Anpassung) ──
WATCH_FOLDER=/data/pdfs
HASH_FOLDER=/data/processed/hashes
REPORT_DIR=/data/processed
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_TEXT=petra_text_chunks
CHROMA_COLLECTION_TAG=petra_tag_chunks
CHROMA_BATCH_SIZE=500
# Batchgröße für Status-Abfragen
STATUS_BATCH_SIZE=500


# ── PDF-Teilung Einstellungen ─────────────────────────────
PDF_SPLIT_TARGET_MB=48
PDF_ARCHIVE_FOLDER=/data/pdfs_original