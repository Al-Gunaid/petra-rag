      "name": "split-pdf"
    },
    {
      "parameters": {
        "jsCode": "// Alle Antworten des Split-Endpunkts einlesen.\n// Ein Input entspricht jeweils einer großen Original-PDF.\nconst inputs = $input.all();\n\nconst outputItems = [];\n\ninputs.forEach((input, inputIndex) => {\n  const data = input.json;\n  const parts = Array.isArray(data.parts) ? data.parts : [];\n\n  parts.forEach((part, partIndex) => {\n    outputItems.push({\n      json: {\n        // Name und Größe der erzeugten Teil-PDF\n        filename: part.filename,\n        size_bytes: part.size_bytes,\n        size_mb: part.size_mb,\n\n        // Gemeinsame Dokumentinformationen\n        original_file: data.original,\n        hash: data.hash,\n        document_hash: data.hash,\n\n        // Unterscheidung der einzelnen Teile\n        part_number: partIndex + 1,\n        part_count: parts.length,\n\n        // Die Datei wurde bereits geteilt\n        needs_split: false,\n      },\n\n      // Sehr wichtig:\n      // Damit weiß n8n, aus welchem Split-Input dieses Item stammt.\n      pairedItem: {\n        item: inputIndex,\n      },\n    });\n  });\n});\n\nreturn outputItems;"
      },
