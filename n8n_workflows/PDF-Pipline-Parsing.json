      "id": "0f70e044-d79a-4dfa-8517-bbbf29eb39a5",
      "name": "✅ Text OK (kein OCR)"
    },
    {
      "parameters": {
        "jsCode": "const extracted =\n  $('📄 PyMuPDF: Text + Tabellen').item.json;\n\nconst ocrResult =\n  $('🔡 Tesseract OCR').item.json;\n\nconst ocrChunks = Array.isArray(ocrResult.chunks)\n  ? ocrResult.chunks.filter(chunk => chunk.type === 'ocr')\n  : [];\n\nconst processedPages = Array.isArray(ocrResult.processed_pages)\n  ? ocrResult.processed_pages.map(Number)\n  : [];\n\nconst ocrPages = new Set(processedPages);\n\nconst normalChunks = Array.isArray(extracted.chunks)\n  ? extracted.chunks.filter(chunk => {\n      return !(\n        chunk.type === 'text' &&\n        ocrPages.has(Number(chunk.page))\n      );\n    })\n  : [];\n\nreturn [{\n  json: {\n    ...extracted,\n    requested_ocr_pages:\n      ocrResult.requested_pages ?? [],\n    processed_ocr_pages:\n      processedPages,\n    ocr_blocks:\n      ocrChunks.length,\n    low_confidence_pages:\n      ocrResult.low_confidence_pages ?? [],\n    failed_ocr_pages:\n      ocrResult.failed_pages ?? [],\n    chunks: [\n      ...normalChunks,\n      ...ocrChunks,\n    ],\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
