    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    status: \"⚠️ Keine neuen PDFs\",\n    hinweis: \"Bitte PDFs in ~/petra-rag/data/pdfs/ ablegen\",\n    zeitstempel: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
