    {
      "parameters": {
        "jsCode": "const csv    = $('CSV Export').first().json;\nconst status = $('📊 ChromaDB Status').first().json;\nreturn [{\n  json: {\n    \"✅ Status\":             csv.status,\n    \"📄 Dateien importiert\": status.gesamt_dateien,\n    \"💾 Chunks gesamt\":      status.gesamt_chunks,\n    \"📑 CSV gespeichert\":    csv.pfad,\n    \"🕐 Zeitstempel\":        new Date().toISOString()\n  }\n}];"
