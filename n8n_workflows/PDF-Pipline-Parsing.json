        -1072,
        448
      ],
      "id": "3dfe1a03-a725-418d-a2ea-405e5d759ec8",
      "name": "Keine neuen PDFs"
    },
    {
      "parameters": {
        "jsCode": "// Gesamtergebnis von List_pdfs lesen\nconst data = $input.first().json;\n\n// Maximale Zahl der PDFs pro Workflow-Lauf\nconst LIMIT = 1200;\n\n// Nur neue und gültige PDFs übernehmen.\n// Große PDFs bleiben enthalten, weil sie valid=true haben.\nconst neuePdfDateien = (data.pdfs ?? [])\n  .filter((pdf) => {\n    return pdf.neu === true && pdf.valid === true;\n  })\n  .slice(0, LIMIT);\n\n// Jede PDF wird zu einem eigenen n8n-Item.\nreturn neuePdfDateien.map((pdf) => ({\n  json: pdf,\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        208
      ],
